{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurochess.local/schemas/proof_carrying_contract.schema.json",
  "title": "OMEGA Proof-Carrying Mission Contract",
  "type": "object",
  "required": [
    "schema_version",
    "mission_id",
    "objective_id",
    "objective",
    "expected_proof",
    "allowed_paths",
    "forbidden_paths",
    "max_files",
    "max_diff_lines",
    "test_commands",
    "stop_conditions",
    "evidence_artifacts",
    "score_delta_rules",
    "safety_rules",
    "final_verdicts"
  ],
  "properties": {
    "schema_version": { "const": "proof_carrying_contract_v1" },
    "mission_id": { "type": "string" },
    "objective_id": { "type": "string" },
    "objective": { "type": "string" },
    "expected_proof": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbidden_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "max_files": { "type": "integer", "minimum": 1 },
    "max_diff_lines": { "type": "integer", "minimum": 1 },
    "test_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "evidence_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "score_delta_rules": { "type": "object" },
    "safety_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "final_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
