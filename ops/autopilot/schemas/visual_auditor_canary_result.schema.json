{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_auditor_canary_result.schema.json",
  "title": "A20C Visual Auditor Canary Result",
  "type": "object",
  "required": ["canary_result", "missed_claims", "recommended_action"],
  "properties": {
    "canary_result": { "enum": ["PASS", "STOP_AUDITOR_CANARY_FAILED"] },
    "missed_claims": { "type": "array", "items": { "type": "string" } },
    "recommended_action": { "enum": ["CONTINUE", "QUARANTINE", "STOP"] },
    "gemini_verdict": { "type": ["string", "null"] },
    "live_chatgpt_called": { "type": "boolean" },
    "live_gemini_called": { "type": "boolean" },
    "product_mission_executed": { "type": "boolean" }
  },
  "additionalProperties": true
}
