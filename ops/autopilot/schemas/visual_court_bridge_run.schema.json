{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroChess Visual Court Bridge Run",
  "type": "object",
  "required": [
    "schema_version",
    "mission_id",
    "evidence_path",
    "output_path",
    "mode",
    "mode_result",
    "judge_validation",
    "creative_director_final_verdict",
    "selected_action",
    "score_estimate_after_bridge",
    "live_chatgpt_called",
    "live_gemini_called",
    "product_mission_executed"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "mission_id": { "type": "string" },
    "evidence_path": { "type": "string" },
    "output_path": { "type": "string" },
    "mode": {
      "enum": ["OFFLINE_FIXTURE_MODE", "MANUAL_PACKET_MODE", "SAFE_LIVE_READONLY_MODE"]
    },
    "mode_result": { "type": "string" },
    "judge_validation": { "type": "object" },
    "missing_judges": { "type": "array", "items": { "type": "string" } },
    "invalid_judges": { "type": "array", "items": { "type": "string" } },
    "hard_gate_override": { "type": "boolean" },
    "creative_director_final_verdict": { "type": "string" },
    "selected_action": { "type": "string" },
    "next_visual_mission_prompt_path": { "type": "string" },
    "score_estimate_after_bridge": { "type": "number" },
    "live_chatgpt_called": { "type": "boolean" },
    "live_gemini_called": { "type": "boolean" },
    "product_mission_executed": { "type": "boolean" },
    "runtime_user_approval_required": { "type": "boolean" }
  }
}
