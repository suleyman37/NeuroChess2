{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "branch_file_lock_entry.schema.json",
  "title": "A20B Branch File Lock Entry",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mission_id",
    "branch_name",
    "base_branch",
    "file_path",
    "lock_type",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "A20B_branch_file_lock_entry_v1" },
    "run_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "branch_name": { "type": "string" },
    "base_branch": { "type": "string" },
    "commit_sha": { "type": ["string", "null"] },
    "file_path": { "type": "string" },
    "lock_type": { "enum": ["planned_write", "actual_write", "read_only"] },
    "status": { "enum": ["active", "released", "abandoned", "quarantined"] },
    "created_at": { "type": "string" },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
