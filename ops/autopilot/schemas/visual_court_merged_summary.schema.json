{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroChess Visual Court Merged Summary",
  "type": "object",
  "required": [
    "mission_id",
    "evidence_path",
    "screenshot_set",
    "hard_gate_status",
    "chess_arbiter_verdict",
    "gemini_visual_verdict",
    "chatgpt_art_direction_verdict",
    "codex_feasibility_verdict",
    "creative_director_final_verdict",
    "public_screenshot_level",
    "top_defects",
    "top_strengths",
    "missing_inputs",
    "hard_gate_override",
    "live_chatgpt_called",
    "live_gemini_called",
    "product_mission_executed"
  ],
  "properties": {
    "mission_id": { "type": "string" },
    "evidence_path": { "type": "string" },
    "screenshot_set": { "type": "array", "items": { "type": "string" } },
    "hard_gate_status": { "type": "string" },
    "chess_arbiter_verdict": { "type": "string" },
    "gemini_visual_verdict": { "type": "string" },
    "chatgpt_art_direction_verdict": { "type": "string" },
    "codex_feasibility_verdict": { "type": "string" },
    "creative_director_final_verdict": { "type": "string" },
    "public_screenshot_level": { "type": "string" },
    "top_defects": { "type": "array", "items": { "type": "string" } },
    "top_strengths": { "type": "array", "items": { "type": "string" } },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "invalid_inputs": { "type": "array", "items": { "type": "string" } },
    "hard_gate_override": { "type": "boolean" },
    "live_chatgpt_called": { "type": "boolean" },
    "live_gemini_called": { "type": "boolean" },
    "product_mission_executed": { "type": "boolean" }
  }
}
