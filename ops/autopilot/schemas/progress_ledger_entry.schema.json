{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurochess.local/autopilot/progress_ledger_entry.schema.json",
  "title": "A16B Progress Ledger Entry",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "mission_id",
    "mission_hash",
    "started_at",
    "ended_at",
    "status",
    "branch",
    "commit_sha",
    "files_changed_count",
    "diff_lines",
    "evidence_pack_path",
    "external_report_path",
    "tests_run",
    "tests_passed",
    "contract_result",
    "prompt_firewall_result",
    "strategic_pulse_decision",
    "forward_progress",
    "no_progress_reason",
    "stop_reason"
  ],
  "properties": {
    "schema_version": { "const": "A16B_progress_ledger_entry_v1" },
    "session_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "mission_hash": { "type": "string" },
    "started_at": { "type": "string" },
    "ended_at": { "type": "string" },
    "status": { "type": "string" },
    "branch": { "type": "string" },
    "commit_sha": { "type": "string" },
    "files_changed_count": { "type": "integer" },
    "diff_lines": { "type": "integer" },
    "evidence_pack_path": { "type": "string" },
    "external_report_path": { "type": "string" },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "tests_passed": { "type": "boolean" },
    "contract_result": { "type": "string" },
    "prompt_firewall_result": { "type": "string" },
    "strategic_pulse_decision": { "type": "string" },
    "forward_progress": { "type": "boolean" },
    "no_progress_reason": { "type": "string" },
    "stop_reason": { "type": "string" }
  },
  "additionalProperties": true
}
