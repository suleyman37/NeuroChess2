{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "NC_A20D_objective_candidate.schema.json",
  "type": "object",
  "required": [
    "objective_id",
    "category",
    "north_star_vector",
    "expected_e2e_potential",
    "expected_branch_count",
    "expected_files",
    "expected_time_minutes_min",
    "expected_time_minutes_max",
    "branch_overlap_risk",
    "red_tier_risk",
    "visual_audit_required",
    "evidence_expected",
    "marginal_value_score",
    "confidence",
    "reason_to_do_now",
    "reason_not_to_do",
    "recommended_phase"
  ],
  "properties": {
    "objective_id": { "type": "string" },
    "category": { "type": "string" },
    "target_friction_id": { "type": ["string", "null"] },
    "north_star_vector": { "type": "array", "items": { "type": "string" } },
    "expected_e2e_potential": { "type": "boolean" },
    "expected_branch_count": { "type": "integer", "minimum": 0 },
    "expected_files": { "type": "array", "items": { "type": "string" } },
    "expected_time_minutes_min": { "type": "integer", "minimum": 0 },
    "expected_time_minutes_max": { "type": "integer", "minimum": 0 },
    "branch_overlap_risk": { "type": "integer", "minimum": 0, "maximum": 100 },
    "red_tier_risk": { "type": "integer", "minimum": 0, "maximum": 100 },
    "visual_audit_required": { "type": "boolean" },
    "visual_provider_available": { "type": "boolean" },
    "evidence_expected": { "type": "array", "items": { "type": "string" } },
    "marginal_value_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reason_to_do_now": { "type": "string" },
    "reason_not_to_do": { "type": "string" },
    "recommended_phase": { "type": "string" }
  }
}
