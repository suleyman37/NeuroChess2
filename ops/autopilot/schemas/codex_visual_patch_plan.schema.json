{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Visual Patch Plan",
  "type": "object",
  "required": [
    "mission_id",
    "evidence_path",
    "screenshot_set",
    "hard_gate_status",
    "chess_arbiter_verdict",
    "gemini_visual_verdict",
    "chatgpt_art_direction_verdict",
    "anti_generic_verdict",
    "codex_feasibility_verdict",
    "creative_director_final_verdict",
    "public_screenshot_level",
    "awwwards_app_craft_score",
    "visual_competence_score",
    "top_defects",
    "top_strengths",
    "required_patch",
    "allowed_next_action",
    "blocked_reasons",
    "next_mission_prompt_path"
  ],
  "properties": {
    "mission_id": { "type": "string" },
    "evidence_path": { "type": "string" },
    "screenshot_set": { "type": "array", "items": { "type": "string" } },
    "hard_gate_status": { "type": "string" },
    "chess_arbiter_verdict": { "type": "string" },
    "gemini_visual_verdict": { "type": "string" },
    "chatgpt_art_direction_verdict": { "type": "string" },
    "anti_generic_verdict": { "type": "string" },
    "codex_feasibility_verdict": { "type": "string" },
    "creative_director_final_verdict": { "type": "string" },
    "public_screenshot_level": { "type": "string" },
    "awwwards_app_craft_score": { "type": "integer", "minimum": 0, "maximum": 60 },
    "visual_competence_score": { "type": "integer", "minimum": 0, "maximum": 20 },
    "top_defects": { "type": "array", "items": { "type": "string" } },
    "top_strengths": { "type": "array", "items": { "type": "string" } },
    "required_patch": { "type": "string" },
    "allowed_next_action": { "type": "string" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "next_mission_prompt_path": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
