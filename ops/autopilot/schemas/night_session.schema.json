{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurochess.local/autopilot/night_session.schema.json",
  "title": "A16A Night Session State",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "started_at",
    "initial_head",
    "current_head",
    "branch",
    "status",
    "max_steps",
    "max_hours",
    "missions_attempted",
    "missions_succeeded",
    "missions_failed",
    "missions_quarantined",
    "current_step",
    "current_mission_id",
    "current_mission_hash",
    "mission_hashes_seen",
    "total_diff_lines",
    "total_failures",
    "consecutive_failures",
    "last_commit_sha",
    "last_successful_mission_id",
    "last_stop_reason",
    "active_branch",
    "active_risks",
    "disabled_features",
    "allowed_lanes",
    "forbidden_zones",
    "pending_events",
    "last_event_sequence",
    "last_state_update",
    "recommended_next_action"
  ],
  "properties": {
    "schema_version": { "const": "A16A_night_session_v1" },
    "session_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string" },
    "initial_head": { "type": "string" },
    "current_head": { "type": "string" },
    "branch": { "type": "string" },
    "status": { "type": "string" },
    "max_steps": { "type": "integer", "minimum": 1 },
    "max_hours": { "type": "integer", "minimum": 1 },
    "missions_attempted": { "type": "integer", "minimum": 0 },
    "missions_succeeded": { "type": "integer", "minimum": 0 },
    "missions_failed": { "type": "integer", "minimum": 0 },
    "missions_quarantined": { "type": "integer", "minimum": 0 },
    "current_step": { "type": "integer", "minimum": 0 },
    "mission_hashes_seen": { "type": "array", "items": { "type": "string" } },
    "pending_events": { "type": "array", "items": { "type": "string" } },
    "last_event_sequence": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
