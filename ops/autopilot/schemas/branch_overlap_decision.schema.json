{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "branch_overlap_decision.schema.json",
  "title": "A20B Branch Overlap Decision",
  "type": "object",
  "required": ["decision", "recommended_action", "reason"],
  "properties": {
    "decision": { "enum": ["CONTINUE", "REJECT_MISSION", "STACK_ON_PREVIOUS_BRANCH", "QUARANTINE_REQUIRED"] },
    "recommended_action": { "enum": ["CONTINUE", "REJECT_MISSION", "STACK_ON_PREVIOUS_BRANCH", "STOP"] },
    "reason": { "type": "string" },
    "dependency_branch": { "type": ["string", "null"] },
    "live_chatgpt_called": { "type": "boolean" },
    "live_gemini_called": { "type": "boolean" },
    "product_mission_executed": { "type": "boolean" }
  },
  "additionalProperties": true
}
