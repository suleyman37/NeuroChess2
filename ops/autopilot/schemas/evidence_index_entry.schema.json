{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_index_entry.schema.json",
  "title": "A20A Evidence Index Entry",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mission_id",
    "branch",
    "artifact_id",
    "artifact_type",
    "artifact_path",
    "created_at",
    "producer",
    "required_for_e2e",
    "exists_at_append"
  ],
  "properties": {
    "schema_version": { "const": "A20A_evidence_index_entry_v1" },
    "run_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "branch": { "type": "string" },
    "commit_sha": { "type": ["string", "null"] },
    "artifact_id": { "type": "string" },
    "artifact_type": {
      "enum": [
        "test_log",
        "screenshot",
        "contact_sheet",
        "visual_brief",
        "gemini_json",
        "chatgpt_json",
        "report",
        "db_snapshot",
        "git_diff",
        "console_log",
        "network_log",
        "other"
      ]
    },
    "artifact_path": { "type": "string" },
    "created_at": { "type": "string" },
    "producer": { "type": "string" },
    "required_for_e2e": { "type": "boolean" },
    "exists_at_append": { "type": "boolean" },
    "hash_if_available": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
